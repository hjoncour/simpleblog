{
  "name": "@hjoncour/simpleblog",
  "version": "0.2.1",
  "description": "Portable collection logic and a React rich-content renderer for blogs and project showcases.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjoncour/simpleblog.git"
  },
  "homepage": "https://github.com/hjoncour/simpleblog#readme",
  "bugs": {
    "url": "https://github.com/hjoncour/simpleblog/issues"
  },
  "keywords": [
    "blog",
    "content",
    "json",
    "react",
    "renderer",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "index.d.ts",
    "index.js",
    "react.d.ts",
    "react.js",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "react.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.3"
  }
}